# PaperTrail configuration — copy to .env (or export in your shell) and fill in.
# Everything except an LLM API key is optional and has sensible defaults.

# ── LLM provider (one of the two; Groq is preferred) ──────────────────────────
GROQ_API_KEY=gsk_your-key-here
# GEMINI_API_KEY=            # fallback provider if GROQ_API_KEY is unset

# ── Models ─────────────────────────────────────────────────────────────────────
# GROQ_MODEL=                # override the default model for both lanes
# LLM_MODEL_FAST=            # cheap/fast lane: classification, extraction, fact-check
# LLM_MODEL_QUALITY=         # strong lane: final answer synthesis

# ── Server ─────────────────────────────────────────────────────────────────────
# PORT=8000                  # HF Spaces/Render/Fly set this automatically (HF default 7860)
# STATE_DIR=./state          # persistent storage root (HF Spaces: /data)
# CORS_ORIGINS=*             # comma-separated allowed origins
# ADMIN_TOKEN=               # if set, DELETE /reset and DELETE /papers/{id} require
                             # the X-Admin-Token header — set this on public deploys
# MAX_UPLOAD_MB=50           # max PDF size for /upload and /upload-url

# ── Retrieval ──────────────────────────────────────────────────────────────────
# ENABLE_RERANKER=0          # 1 = cross-encoder rerank stage (needs requirements-reranker.txt)
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Entity extraction budget ───────────────────────────────────────────────────
# EXTRACTION_MAX_CHUNKS=3    # LLM passes per paper (head + middle + tail)
# EXTRACTION_CHUNK_CHARS=8000
# EXTRACTION_OVERLAP_CHARS=600
# EXTRACTION_PARALLELISM=4   # concurrent extraction requests
# SKIP_ENTITY_VALIDATION=0   # 1 = trust raw LLM extraction (skip grounding filter)

# ── Prompt budgets (keep requests under provider TPM caps) ─────────────────────
# PROMPT_PASSAGE_BUDGET_CHARS=16000
# PROMPT_GRAPH_BUDGET_CHARS=4000
